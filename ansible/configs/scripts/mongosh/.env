# MongoDB Connections Config
# Format: MONGO_APP_ENV="connection_string"
# Example: mongo-connect myapp-local

# MYAPP
MONGO_MYAPP_LOCAL="mongodb://user:password@localhost:27017/"

# SSH Tunnel Config (for connections via bastion)
SSH_HOSTS_PROD="host"
SSH_USER="user"
SSH_PORT="22"

# Apps using SSH tunnel (separated by space)
TUNNEL_APPS_PROD="myapp"
